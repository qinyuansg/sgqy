{
  "name": "ai-usecase-1-deck",
  "private": true,
  "description": "Builds the editable decks for AI Use Case 1: the CEO product review and the scenario walkthrough",
  "scripts": {
    "assets": "node make_assets.mjs ../build/deck-assets",
    "build": "node build_deck.js ../build/deck-assets ../build/dist/AI-UseCase1_AGIL-Secure-ISMS_CEO-deck.pptx",
    "scenario:assets": "node scenes/build_assets.mjs ../build/scenario-assets",
    "scenario:build": "node build_scenario_deck.js ../build/scenario-assets ../build/dist/AI-UseCase1_AGIL-Secure-ISMS_Scenario-Walkthrough.pptx"
  },
  "dependencies": {
    "pptxgenjs": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "sharp": "0.35.5"
  }
}
