# /etc/rpi-sb-provisioner/config for the Foyer VK-1 production line.
# Variables are documented in rpi-sb-provisioner's docs/config_vars.md.

# Secure boot + full-disk encryption keyed from the CM5 OTP device-unique key.
PROVISIONING_STYLE=secure-boot
RPI_DEVICE_FAMILY=5
RPI_DEVICE_STORAGE_TYPE=emmc
RPI_DEVICE_STORAGE_CIPHER=aes-xts-plain64

# Gold master from os-image/build.sh (the .img.xz is accepted and decompressed).
GOLD_MASTER_OS_FILE=/srv/rpi-sb-provisioner/images/foyer-vk1-1.0.0-YYYYMMDD.img.xz

# Customer signing key: keep it in an HSM in production.
CUSTOMER_KEY_PKCS11_NAME='pkcs11:object=foyer-boot-signing;type=private'

# Bootloader EEPROM configuration required by the carrier (PSU_MAX_CURRENT=5000).
RPI_DEVICE_BOOTLOADER_CONFIG_FILE=/etc/rpi-sb-provisioner/foyer-bootloader.conf

# Lock down provisioned devices (permanent, written to OTP / EEPROM).
RPI_DEVICE_LOCK_JTAG=1
RPI_DEVICE_EEPROM_WP_SET=1

RPI_SB_PROVISIONER_MANUFACTURING_DB=/srv/rpi-sb-provisioner/manufacturing.db
