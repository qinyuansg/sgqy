#!/bin/sh
# Runs inside cage as user foyer-kiosk: rotate the panel to portrait, wait for
# the agent, then show the enrolment UI in a locked-down, profile-less Chromium.
set -eu

OUTPUT="${FOYER_OUTPUT:-HDMI-A-1}"
URL="http://127.0.0.1:8080/"
PROFILE="${XDG_RUNTIME_DIR:?}/chromium" # tmpfs: nothing survives a restart

wlr-randr --output "${OUTPUT}" --transform 90 || true

i=0
until curl -fsS -o /dev/null "http://127.0.0.1:8080/healthz"; do
  i=$((i + 1))
  [ "${i}" -lt 120 ] || break
  sleep 0.5
done

rm -rf "${PROFILE}"
mkdir -p "${PROFILE}"
export HOME="${XDG_RUNTIME_DIR}"

exec chromium \
  --ozone-platform=wayland \
  --kiosk "${URL}" \
  --user-data-dir="${PROFILE}" \
  --incognito \
  --no-first-run \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-features=Translate,TouchpadOverscrollHistoryNavigation,MediaRouter \
  --overscroll-history-navigation=0 \
  --disable-pinch \
  --autoplay-policy=no-user-gesture-required \
  --check-for-update-interval=31536000 \
  --disk-cache-dir=/dev/null \
  --password-store=basic \
  --enable-features=OverlayScrollbar
