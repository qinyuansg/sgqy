#!/bin/sh
# Open/close the LUKS2 data partition used on development images (production
# devices use rpi-sb-provisioner full-disk encryption and do not need this).
#
# The key is derived on the device from the CM5's OTP device-unique key with
# the firmware crypto service (rpi-fw-crypto, key slot 1, HMAC-SHA256 over the
# eMMC CID), so it never exists at rest. Boards whose key slot has not been
# provisioned fall back to a key file (development only; reported by the agent
# heartbeat as storage_protection=keyfile).
set -eu

NAME=foyerdata
DEVICE=/dev/disk/by-label/foyerdata
KEYFILE=/etc/foyer/data.key
CID=/sys/block/mmcblk0/device/cid

derive_key() {
  if command -v rpi-fw-crypto >/dev/null 2>&1 && [ -r "${CID}" ]; then
    printf 'foyer-data-v1:%s' "$(cat "${CID}")" |
      rpi-fw-crypto hmac --in /dev/stdin --key-id 1 --outform hex 2>/dev/null && return 0
  fi
  [ -r "${KEYFILE}" ] && cat "${KEYFILE}" && return 0
  return 1
}

case "${1:-}" in
  key) derive_key ;;
  open)
    [ -e "/dev/mapper/${NAME}" ] && exit 0
    derive_key | cryptsetup open --type luks2 --key-file=- --allow-discards "${DEVICE}" "${NAME}"
    ;;
  close) cryptsetup close "${NAME}" 2>/dev/null || true ;;
  *) echo "usage: $0 open|close|key" >&2; exit 2 ;;
esac
