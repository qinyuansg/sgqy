[Unit]
Description=Foyer VK-1 kiosk display (cage + Chromium)
After=systemd-user-sessions.service foyer-agent.service plymouth-quit-wait.service
Wants=foyer-agent.service
Conflicts=getty@tty1.service

[Service]
User=foyer-kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# No -s: VT switching stays disabled.
ExecStart=/usr/bin/cage -d -- /usr/lib/foyer/kiosk-session
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
